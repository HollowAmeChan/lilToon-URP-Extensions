// Editor-only high-sample, no-reuse path. Original one-bounce shaders and hit ABI.
#pragma max_recursion_depth 1
#include "HoRTGIDensePrimary.hlsl"
#include "../../../Runtime/RTGI/Shaders/HoRTGI.raytrace"
RWStructuredBuffer<float4> _HoGIDenseRayPrimary;
[shader("raygeneration")]
void ProbeDenseRayPrimary()
{
    uint receiver=DispatchRaysIndex().x;HoRTPrimarySurface original;
    bool valid=HoGIDenseLoadPrimary(uint2(0,receiver),original);
    RAB_Surface mapped=RAB_GetGBufferSurface(int2(0,receiver),false);
    _HoGIDenseRayPrimary[receiver*4]=float4(original.positionWS,valid?1:0);
    _HoGIDenseRayPrimary[receiver*4+1]=float4(mapped.worldPos,RAB_IsSurfaceValid(mapped)?1:0);
    _HoGIDenseRayPrimary[receiver*4+2]=float4(mapped.normal,mapped.viewDepth);
    _HoGIDenseRayPrimary[receiver*4+3]=float4(mapped.material.diffuseAlbedo,1);
}
