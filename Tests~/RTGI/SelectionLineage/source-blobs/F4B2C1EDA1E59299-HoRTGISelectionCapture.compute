#pragma kernel Capture
#pragma use_dxc
#pragma target 6.0
struct Packet{float3 position;uint misc;uint radiance;float weight;uint normal;uint unused;};
StructuredBuffer<Packet> _SourcePacket;
StructuredBuffer<uint4> _SourceMetadata,_SourceOrigin;
RWStructuredBuffer<Packet> _Packet;
RWStructuredBuffer<uint4> _Metadata,_Origin;
int _Width,_Height,_RowPitch,_ArrayPitch,_Pool,_Stage,_Linear;
[numthreads(8,8,1)]
void Capture(uint3 id:SV_DispatchThreadID)
{
    if(id.x>=_Width||id.y>=_Height)return;uint linear=id.y*_Width+id.x;
    uint address=_Linear!=0?linear:(id.y/16)*_RowPitch+(id.x/16)*256+(id.y%16)*16+id.x%16+_Pool*_ArrayPitch;
    uint target=_Stage*_Width*_Height+linear;_Packet[target]=_SourcePacket[address];_Metadata[target]=_SourceMetadata[address];_Origin[target]=_SourceOrigin[address];
}
