#pragma kernel Burn
#pragma target 4.5
RWStructuredBuffer<uint> _Output;
int _Iterations,_Seed;
[numthreads(64,1,1)]
void Burn(uint3 id:SV_DispatchThreadID)
{
    uint value=id.x+uint(_Seed);
    [loop]for(int i=0;i<_Iterations;i++){value^=value>>13;value*=0x85ebca6b;value^=value>>16;value+=uint(i)*0x9e3779b9;}
    _Output[id.x]=value;
}
