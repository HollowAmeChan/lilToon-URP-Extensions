#pragma kernel Prepare
#pragma kernel Decode
#pragma kernel Accumulate HO_SIGMA_ACCUMULATE=1
#pragma use_dxc
#pragma target 6.0
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "../../RT/Shaders/HoRTPrimarySurface.hlsl"
#include "../../RTDI/ThirdParty/NRD/NRD.hlsli"
Texture2D<float4> _HoRTShadowRaw;
RWTexture2D<float4> _HoRTShadowNormal,_HoRTShadowMotion;
RWTexture2D<float> _HoRTShadowViewZ,_HoRTShadowPenumbra;
Texture2D<float> _HoRTShadowSigmaEncoded,_HoRTShadowSigmaViewZ;
RWTexture2D<float4> _HoRTShadowSigmaVisibility;
float4 _HoRTShadowSigmaSize,_HoRTShadowSigmaLight;
#if defined(HO_SIGMA_ACCUMULATE)
RWTexture2D<float2> _HoRTShadowSigmaSum;
uint _HoRTShadowEstimateIndex;
#endif
[numthreads(8,8,1)]
void Prepare(uint2 pixel:SV_DispatchThreadID)
{
    if(any(pixel>=(uint2)_HoRTShadowSigmaSize.xy))return;
    _HoRTShadowMotion[pixel]=0;
    _HoRTShadowViewZ[pixel]=1e7;
    _HoRTShadowPenumbra[pixel]=0;
    _HoRTShadowNormal[pixel]=NRD_FrontEnd_PackNormalAndRoughness(float3(0,0,-1),.5,0);
    float4 raw=_HoRTShadowRaw[pixel];
    HoRTPrimarySurface surface;
    if(raw.z!=1||!HoRTTryLoadPrimarySurface(pixel,surface)||surface.ownerAvailable==0||surface.owner!=(uint)raw.w)return;
    // SIGMA's domain is front-lit mesh geometry. NPR's half-Lambert or
    // modified-normal domain can be wider and keeps its actual raw visibility.
    if(dot(surface.geometricNormalWS,_HoRTShadowSigmaLight.xyz)<=0)return;
    _HoRTShadowViewZ[pixel]=surface.eyeDepth;
    _HoRTShadowNormal[pixel]=NRD_FrontEnd_PackNormalAndRoughness(surface.geometricNormalWS,.5,0);
    _HoRTShadowPenumbra[pixel]=SIGMA_FrontEnd_PackPenumbra(raw.y,_HoRTShadowSigmaLight.w);
}
void DecodeVisibility(uint2 pixel)
{
    if(any(pixel>=(uint2)_HoRTShadowSigmaSize.xy))return;
    float4 raw=_HoRTShadowRaw[pixel];
    float measuredVisibility=raw.x;
    if(raw.z==1&&_HoRTShadowSigmaViewZ[pixel]<500000)
        raw.x=saturate(SIGMA_BackEnd_UnpackShadow(_HoRTShadowSigmaEncoded[pixel]));
    #if defined(HO_SIGMA_ACCUMULATE)
        // Average only linear, officially decoded visibility. Each upstream
        // denoiser execution sees a single actual hit or miss and resets history.
        float2 sum=(_HoRTShadowEstimateIndex==0?0:_HoRTShadowSigmaSum[pixel])+float2(raw.x,measuredVisibility);
        _HoRTShadowSigmaSum[pixel]=sum;
        float count=_HoRTShadowEstimateIndex+1;
        float estimate=sum.x/count,measured=sum.y/count;
        // Wilson's score interval supplies a conservative binomial-inspired
        // bound. These spatially randomized rays are not a confidence guarantee:
        // the purpose is to stop spatial reconstruction erasing a thin feature
        // when independent actual samples agree. Original SIGMA stays untouched.
        float zSquared=3.8416;
        float denominator=1+zSquared/count;
        float centre=(measured+zSquared/(2*count))/denominator;
        float radius=1.96*sqrt(measured*(1-measured)/count+zSquared/(4*count*count))/denominator;
        raw.x=clamp(estimate,max(0,centre-radius),min(1,centre+radius));
    #endif
    _HoRTShadowSigmaVisibility[pixel]=raw;
}
[numthreads(8,8,1)]
void Decode(uint2 pixel:SV_DispatchThreadID){DecodeVisibility(pixel);}
[numthreads(8,8,1)]
void Accumulate(uint2 pixel:SV_DispatchThreadID){DecodeVisibility(pixel);}
