#pragma max_recursion_depth 1
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "../../RT/Shaders/HoRTPrimarySurface.hlsl"
#include "../../RT/Shaders/HoRTNativeVisibility.hlsl"
StructuredBuffer<uint> _HoRTShadowReceivers;
StructuredBuffer<uint> _HoRTShadowInstanceOwners;
uint _HoRTShadowInstanceOwnerCount;
float _HoRTShadowTerminatorCorrection;
RWTexture2D<float4> _HoRTShadowOutput;
float4 _HoRTShadowDirection; // toward centre, 1-cos(angular radius), computed with sin to retain tiny angles
float4 _HoRTShadowParameters; // full output size, min/max metres
uint _HoRTShadowSamples,_HoRTShadowSeed;
float4 _HoRTShadowLocalPosition,_HoRTShadowLocalForward;
uint _HoRTShadowLightType; // 0 directional, 1 delta point, 2 delta spot

uint HoRTShadowHash(uint x)
{x^=x>>16;x*=0x7feb352du;x^=x>>15;x*=0x846ca68bu;x^=x>>16;return x;}
float3 HoRTShadowSampleDirection(uint2 pixel,uint sampleIndex)
{
    float3 centre=normalize(_HoRTShadowDirection.xyz);
    if(_HoRTShadowDirection.w<=0)return centre;
    uint hash=HoRTShadowHash(pixel.x+pixel.y*(uint)_HoRTShadowParameters.x+_HoRTShadowSeed*0x9e3779b9u);
    float2 rotation=float2(hash&65535u,hash>>16)/65536.0;
    float2 u=frac(rotation+float2((sampleIndex+.5)/_HoRTShadowSamples,frac(sampleIndex*.6180339887498948)));
    float delta=_HoRTShadowDirection.w*u.x;
    float cosTheta=1-delta,sinTheta=sqrt(max(0,delta*(2-delta)));
    float3 tangent=normalize(cross(abs(centre.z)<.999?float3(0,0,1):float3(0,1,0),centre));
    float3 bitangent=cross(centre,tangent);float si,co;sincos(6.28318530718*u.y,si,co);
    return centre*cosTheta+(tangent*co+bitangent*si)*sinTheta;
}
float3 HoRTShadowRayOrigin(HoRTPrimarySurface surface,float3 direction,float3 triangleNormal)
{
    // Raster depth reconstruction and AS intersection do not round to the
    // same plane. TMin alone shrinks the normal clearance by abs(N.L), which
    // makes tiny depth errors become large self-shadows at grazing angles.
    // Use the mesh normal, never its normal-map/shading-normal perturbation.
    float3 normal=triangleNormal;
    normal=dot(normal,direction)>=0?normal:-normal;
    // Also keep the displacement representable away from the world origin.
    // This is a raster-origin guard, not a claimed triangle-error bound.
    float rounding=dot(abs(surface.positionWS),abs(normal))*4.76837158203125e-7;
    return surface.positionWS+normal*max(_HoRTShadowParameters.z,rounding);
}
[shader("raygeneration")]
void Cast()
{
    uint2 pixel=DispatchRaysIndex().xy;
    _HoRTShadowOutput[pixel]=float4(0,0,2,0);
    HoRTPrimarySurface surface;
    if(!HoRTTryLoadPrimarySurface(pixel,surface)||surface.ownerAvailable==0)return;
    uint owner=surface.owner;
    if(owner==0||owner>65535||(_HoRTShadowReceivers[owner>>5]&(1u<<(owner&31)))==0)
    {_HoRTShadowOutput[pixel]=0;return;}
    if(any((uint2)_HoRTPrimarySize.xy!=(uint2)_HoRTShadowParameters.xy))return;
    // Smooth vertex normals are not the plane that AS traversal intersects.
    // Resolve only a very local camera segment, and accept a face normal only
    // from the current receiver identity. Keep the original raster position:
    // do not snap a receiver onto a neighbouring layer or discard close hits.
    float3 triangleNormal=surface.geometricNormalWS;
    float window=max(_HoRTShadowParameters.z*4,surface.eyeDepth*2e-6+dot(abs(surface.positionWS),1.0)*9.5367431640625e-7);
    HoRTVisibilityHit primary=HoRTTraceClosestVisibility(surface.positionWS+surface.viewDirectionWS*window,-surface.viewDirectionWS,0,window*2,255);
    if(primary.status>1){_HoRTShadowOutput[pixel]=float4(0,0,10+primary.status,owner);return;}
    if(primary.status==1&&primary.instance<_HoRTShadowInstanceOwnerCount&&_HoRTShadowInstanceOwners[primary.instance]==owner)
    {
        float3 actualNormal=HoRTVisibilityUnpackNormal(primary.triangleNormal);
        if(abs(dot(actualNormal,surface.geometricNormalWS))>.25)triangleNormal=actualNormal;
        float3 offset=primary.smoothOffset*saturate(_HoRTShadowTerminatorCorrection);
        // The smooth surface is an explicit approximation, separate from
        // numerical bias. Do not move through a nearby blocker while applying
        // it: clamp the displacement before the first real bridge intersection.
        float lengthSquared=dot(offset,offset);
        if(lengthSquared>4*_HoRTShadowParameters.z*_HoRTShadowParameters.z&&dot(offset,actualNormal)*dot(surface.geometricNormalWS,actualNormal)>0)
        {
            float3 bridgeNormal=dot(offset,actualNormal)>=0?actualNormal:-actualNormal;
            float3 bridgeStart=surface.positionWS+bridgeNormal*_HoRTShadowParameters.z;
            float3 bridgeDelta=surface.positionWS+offset-bridgeStart;
            float bridgeLength=length(bridgeDelta);
            HoRTVisibilityHit bridge=HoRTTraceClosestVisibility(bridgeStart,bridgeDelta/bridgeLength,_HoRTShadowParameters.z,bridgeLength,255);
            if(bridge.status>1){_HoRTShadowOutput[pixel]=float4(0,0,10+bridge.status,owner);return;}
            float fraction=bridge.status==1?saturate((bridge.distance-2*_HoRTShadowParameters.z)/bridgeLength):1;
            surface.positionWS+=offset*fraction;
        }
    }
    float3 localDirection=0;float maximum=_HoRTShadowParameters.w;
    if(_HoRTShadowLightType!=0)
    {
        float3 delta=_HoRTShadowLocalPosition.xyz-surface.positionWS;float distanceToLight=length(delta);
        if(distanceToLight<=_HoRTShadowParameters.z*2||distanceToLight>_HoRTShadowLocalPosition.w)
        {_HoRTShadowOutput[pixel]=float4(0,0,3,owner);return;}
        localDirection=delta/distanceToLight;
        if(_HoRTShadowLightType==2&&dot(-localDirection,_HoRTShadowLocalForward.xyz)<_HoRTShadowLocalForward.w)
        {_HoRTShadowOutput[pixel]=float4(0,0,3,owner);return;}
        if(distanceToLight>maximum){_HoRTShadowOutput[pixel]=float4(0,0,4,owner);return;}
        maximum=distanceToLight-_HoRTShadowParameters.z;
    }
    uint visible=0;float closest=65504;
    for(uint sampleIndex=0;sampleIndex<_HoRTShadowSamples;sampleIndex++)
    {
        float3 direction=_HoRTShadowLightType==0?HoRTShadowSampleDirection(pixel,sampleIndex):localDirection;
        float3 origin=HoRTShadowRayOrigin(surface,direction,triangleNormal);
        float rayMaximum=maximum;
        if(_HoRTShadowLightType!=0)
        {
            // Keep delta local rays aimed at the real light endpoint after
            // the normal offset; neither direction nor endpoint may be stale.
            float3 delta=_HoRTShadowLocalPosition.xyz-origin;
            float distanceToLight=length(delta);direction=delta/distanceToLight;
            rayMaximum=distanceToLight-_HoRTShadowParameters.z;
        }
        HoRTVisibilityHit hit=HoRTTraceClosestVisibility(origin,direction,_HoRTShadowParameters.z,rayMaximum,255);
        if(hit.status>1){_HoRTShadowOutput[pixel]=float4(0,0,10+hit.status,owner);return;}
        if(hit.status==0)visible++;else closest=min(closest,hit.distance);
    }
    _HoRTShadowOutput[pixel]=float4((float)visible/_HoRTShadowSamples,closest,1,owner);
}
