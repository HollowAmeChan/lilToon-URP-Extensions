#pragma kernel ExtractPositions
#pragma kernel TriangleMetrics
#pragma kernel VertexGather
#pragma kernel SmoothVertices
#pragma kernel BlendSmoothing

ByteAddressBuffer _Source;
RWStructuredBuffer<float4> _Positions;
StructuredBuffer<float4> _RestPositions;
StructuredBuffer<uint> _Triangles;
StructuredBuffer<float4> _RestMetrics;
StructuredBuffer<uint> _NeighborOffsets;
StructuredBuffer<uint> _Neighbors;
StructuredBuffer<uint> _CornerOffsets;
StructuredBuffer<uint> _Corners;
RWStructuredBuffer<float4> _TriangleMetrics;
RWStructuredBuffer<float4> _Tension;
StructuredBuffer<float4> _SmoothInput;
RWStructuredBuffer<float4> _SmoothOutput;
int _SmoothInputOffset;
float _SmoothBlend;
float4x4 _RendererToWorld;
int _VertexCount, _TriangleCount, _Stride, _OutputOffset;
float _LengthEpsilon, _AreaEpsilon;
float3 _Weights;
float4x4 _ToRendererLocal;
float Angle(float3 a,float3 b) { return atan2(length(cross(a,b)),dot(a,b)); }
[numthreads(64,1,1)]
void ExtractPositions(uint id:SV_DispatchThreadID)
{
    if(id>=(uint)_VertexCount)return;
    float3 p=asfloat(_Source.Load3(id*(uint)_Stride));
    p=mul(_ToRendererLocal,float4(p,1)).xyz;
    _Positions[id]=float4(p,all(isfinite(p)) ? 1 : 0);
}
[numthreads(64,1,1)]
void TriangleMetrics(uint id:SV_DispatchThreadID)
{
    if(id>=(uint)_TriangleCount)return;
    uint3 t=uint3(_Triangles[id*3],_Triangles[id*3+1],_Triangles[id*3+2]);
    float4 pa=_Positions[t.x],pb=_Positions[t.y],pc=_Positions[t.z];
    float3 a=pa.xyz,b=pb.xyz,c=pc.xyz;
    float4 rest=_RestMetrics[id];float area=length(cross(b-a,c-a))*0.5;
    if(rest.x<=_AreaEpsilon || area<=_AreaEpsilon || pa.w*pb.w*pc.w<0.5 || !isfinite(area))
    { _TriangleMetrics[id]=0;return; }
    _TriangleMetrics[id]=float4(log(area/rest.x),(float3(Angle(b-a,c-a),Angle(a-b,c-b),Angle(a-c,b-c))-rest.yzw)/3.141592653589793);
}
[numthreads(64,1,1)]
void VertexGather(uint id:SV_DispatchThreadID)
{
    if(id>=(uint)_VertexCount)return;
    if(_Positions[id].w<0.5){_Tension[_OutputOffset+id]=0;return;}
    float stretch=0,compression=0,edgeWeight=0;bool invalid=false;
    for(uint i=_NeighborOffsets[id];i<_NeighborOffsets[id+1];i++)
    {
        uint n=_Neighbors[i];float restLength=distance(_RestPositions[id].xyz,_RestPositions[n].xyz);
        if(restLength<=_LengthEpsilon)continue;
        if(_Positions[n].w<0.5){invalid=true;continue;}
        float strain=log(max(distance(_Positions[id].xyz,_Positions[n].xyz),_LengthEpsilon)/restLength);
        stretch+=max(strain,0);compression+=max(-strain,0);edgeWeight++;
    }
    float areaStretch=0,areaCompression=0,angular=0,areaWeight=0;
    for(uint cornerIndex=_CornerOffsets[id];cornerIndex<_CornerOffsets[id+1];cornerIndex++)
    {
        uint corner=_Corners[cornerIndex],triId=corner/3;float weight=_RestMetrics[triId].x;
        if(weight<=_AreaEpsilon)continue;
        float4 metrics=_TriangleMetrics[triId];areaStretch+=max(metrics.x,0)*weight;areaCompression+=max(-metrics.x,0)*weight;
        angular+=abs(metrics[corner%3+1])*weight;areaWeight+=weight;
    }
    float4 result=float4(_Weights.x*stretch/max(edgeWeight,1)+_Weights.y*areaStretch/max(areaWeight,_AreaEpsilon),
        _Weights.x*compression/max(edgeWeight,1)+_Weights.y*areaCompression/max(areaWeight,_AreaEpsilon),
        _Weights.z*angular/max(areaWeight,_AreaEpsilon),!invalid && (edgeWeight>0 || areaWeight>0) ? 1 : 0);
    _Tension[_OutputOffset+id]=all(isfinite(result)) && result.w>0.5 ? result : 0;
}

[numthreads(64,1,1)]
void SmoothVertices(uint id:SV_DispatchThreadID)
{
    if(id>=(uint)_VertexCount)return;
    float4 center=_SmoothInput[_SmoothInputOffset+id];
    if(center.w<0.5 || _Positions[id].w<0.5){_SmoothOutput[id]=center;return;}
    float3 sum=0;float weights=0,distances=0;uint count=0;
    for(uint neighborIndex=_NeighborOffsets[id];neighborIndex<_NeighborOffsets[id+1];neighborIndex++)
    {
        uint n=_Neighbors[neighborIndex];float4 value=_SmoothInput[_SmoothInputOffset+n];
        if(value.w<0.5 || _Positions[n].w<0.5 || !all(isfinite(value)))continue;
        // Translation cancels; the full linear transform retains object/parent nonuniform scale.
        float distanceWS=length(mul((float3x3)_RendererToWorld,_Positions[n].xyz-_Positions[id].xyz));
        if(!isfinite(distanceWS))continue;
        float d=max(distanceWS,1e-6),weight=rcp(d);
        sum+=value.xyz*weight;weights+=weight;distances+=d;count++;
    }
    if(count==0){_SmoothOutput[id]=center;return;}
    // Include the center at a typical neighbor distance, avoiding an infinite inverse-distance self weight.
    float centerWeight=count/max(distances,1e-6);
    float3 averaged=(sum+center.xyz*centerWeight)/(weights+centerWeight);
    _SmoothOutput[id]=all(isfinite(averaged)) ? float4(averaged,center.w) : center;
}
[numthreads(64,1,1)]
void BlendSmoothing(uint id:SV_DispatchThreadID)
{
    if(id>=(uint)_VertexCount)return;
    float4 raw=_Tension[_OutputOffset+id],smoothed=_SmoothInput[id];
    // Validity is never blurred or manufactured from valid neighbors.
    if(raw.w<0.5 || smoothed.w<0.5 || !all(isfinite(smoothed)))return;
    _Tension[_OutputOffset+id]=float4(lerp(raw.xyz,smoothed.xyz,saturate(_SmoothBlend)),raw.w);
}
