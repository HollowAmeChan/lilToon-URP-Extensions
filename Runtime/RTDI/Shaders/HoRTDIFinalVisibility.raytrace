#pragma max_recursion_depth 1
#define HO_RTDI_ENVIRONMENT_ENABLED 1
#include "HoRTDIApplicationBridge.hlsl"
#include "../ThirdParty/RTXDI/DI/ReservoirStorage.hlsl"
#include "HoRTDIAuxiliary.hlsl"
#include "HoRTDIVisibilityPayload.hlsl"
RWTexture2D<float> _HoRTDIFinalVisibility;
Texture2D<float2> _HoRTDIPreviousLuminance;
RWTexture2D<float4> _HoRTDIGradientA;

[shader("miss")]
void HoRTDIVisibilityMiss(inout HoRTDIVisibilityPayload payload : SV_RayPayload) {payload.blocked=0;}

bool HoDITraceFinal(RAB_Surface surface,RAB_LightSample sample)
{
    float3 direction;float distance;RAB_GetLightDirDistance(surface,sample,direction,distance);
    float bias=_HoRTDISettings.w;
    if(distance<=bias*2||!all(isfinite(direction)))return false;
    RayDesc ray;ray.Origin=surface.worldPos;ray.Direction=direction;ray.TMin=bias;ray.TMax=distance-bias;
    HoRTDIVisibilityPayload payload=(HoRTDIVisibilityPayload)0;
    TraceRay(_HoRTSceneAccelerationStructure,RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH|RAY_FLAG_SKIP_PROCEDURAL_PRIMITIVES,255,0,1,0,ray,payload);
    return payload.blocked==0;
}

[shader("raygeneration")]
void FinalVisibility()
{
    uint2 pixel=DispatchRaysIndex().xy;
    _HoRTDIFinalVisibility[pixel]=0;
    RAB_Surface surface=RAB_GetGBufferSurface(pixel,false);
    RTXDI_ReservoirBufferParameters layout=(RTXDI_ReservoirBufferParameters)0;
    layout.reservoirBlockRowPitch=(uint)_HoRTDIReservoirLayout.x;layout.reservoirArrayPitch=(uint)_HoRTDIReservoirLayout.y;
    RTXDI_DIReservoir reservoir=RTXDI_LoadDIReservoir(layout,pixel,1);
    uint bits=0;
    if(RAB_IsSurfaceValid(surface)&&RTXDI_IsValidDIReservoir(reservoir))
    {RAB_LightSample sample=RAB_SamplePolymorphicLight(RAB_LoadLightInfo(RTXDI_GetDIReservoirLightIndex(reservoir),false),surface,RTXDI_GetDIReservoirSampleUV(reservoir));bits=HoDITraceFinal(surface,sample)?1:0;}
    if(HoDIUseAuxiliary())
    {
        RTXDI_RandomSamplerState rng=RTXDI_InitRandomSampler(pixel,(uint)_HoRTDIFrameIndex,0x6f527bbdu);
        for(uint draw=0;draw<2;draw++)
        {
            RTXDI_DIReservoir extra=RTXDI_EmptyDIReservoir();bool visible=false;
            if(RAB_IsSurfaceValid(surface)){extra=HoDIFreshAuxiliary(rng);RAB_LightSample sample=RAB_SamplePolymorphicLight(RAB_LoadLightInfo(RTXDI_GetDIReservoirLightIndex(extra),false),surface,RTXDI_GetDIReservoirSampleUV(extra));visible=HoDITraceFinal(surface,sample);}
            if(visible)bits|=1u<<(draw+1);
            if(draw==0)RTXDI_StoreDIReservoir(extra,layout,pixel,2);
            else _HoRTDIRuntimeAuxiliarySecondary[pixel.y*(uint)_HoRTDIFrame.x+pixel.x]=HoDIPackRuntimeAuxiliary(extra,visible);
        }
        _HoRTDIFinalVisibility[pixel]=bits/7.0;
    }
    else _HoRTDIFinalVisibility[pixel]=bits;
}

// Re-evaluate exactly the previous shaded samples against the current TLAS.
// No new RNG or current-frame reservoir enters this lighting-change signal.
[shader("raygeneration")]
void VisibilityGradients()
{
    uint2 cell=DispatchRaysIndex().xy;
    float4 gradient=0;float2 largest=0;
    RTXDI_ReservoirBufferParameters layout=(RTXDI_ReservoirBufferParameters)0;
    layout.reservoirBlockRowPitch=(uint)_HoRTDIReservoirLayout.x;layout.reservoirArrayPitch=(uint)_HoRTDIReservoirLayout.y;
    if(_HoRTDIFlags.x>.5)
    for(int y=0;y<3;y++)for(int x=0;x<3;x++)
    {
        int2 pixel=int2(cell)*3+int2(x,y);if(any(pixel>=(int2)_HoRTDIFrame.xy))continue;
        RAB_Surface current=RAB_GetGBufferSurface(pixel,false);if(!RAB_IsSurfaceValid(current))continue;
        float4 clip=mul(_HoRTDIPreviousVP,float4(current.worldPos,1));if(abs(clip.w)<1e-6)continue;
        float2 uv=clip.xy/clip.w*.5+.5;
        #if UNITY_UV_STARTS_AT_TOP
        uv.y=1-uv.y;
        #endif
        int2 old=int2(floor(uv*_HoRTDIFrame.xy));if(any(old<0)||any(old>=(int2)_HoRTDIFrame.xy))continue;
        RAB_Surface surface=RAB_GetGBufferSurface(old,true);
        if(!RAB_IsSurfaceValid(surface)||dot(current.normal,surface.normal)<.9||distance(current.worldPos,surface.worldPos)>.02*max(1,current.viewDepth))continue;
        // Reprojected correspondence: move the old shading sample to the
        // current surface before querying the current TLAS. An old origin can
        // lie behind a moving receiver and falsely count its own geometry.
        RAB_Surface oldSampleSurface=surface;surface.worldPos=current.worldPos;
        RTXDI_DIReservoir reservoir=RTXDI_LoadDIReservoir(layout,old,0);
        float2 previous=HoDIUseAuxiliary()?HoDICachedRuntimePrimaryLuminance(reservoir,oldSampleSurface,true):_HoRTDIPreviousLuminance.Load(int3(old,0)),traced=0;
        int mapped=RTXDI_IsValidDIReservoir(reservoir)?RAB_TranslateLightIndex(RTXDI_GetDIReservoirLightIndex(reservoir),false):-1;
        if(mapped>=0)
        {
            RAB_LightSample sample=RAB_SamplePolymorphicLight(RAB_LoadLightInfo(mapped,false),surface,RTXDI_GetDIReservoirSampleUV(reservoir));
            float3 L;float distance;RAB_GetLightDirDistance(surface,sample,L,distance);
            if(dot(L,surface.geoNormal)>0&&HoDITraceFinal(surface,sample))
            {
                float3 radiance=sample.radiance*RTXDI_GetDIReservoirInvPdf(reservoir)/max(sample.solidAnglePdf,1e-12);
                float3 d=Lambert(surface.normal,-L)*surface.material.diffuseAlbedo*radiance;
                float3 p=0;if(surface.material.roughness>=.03)p=GGX_times_NdotL(surface.viewDir,L,surface.normal,max(.03,surface.material.roughness),surface.material.specularF0)*radiance;
                d=f16tof32(f32tof16(d));p=f16tof32(f32tof16(p));
                traced=f16tof32(f32tof16(float2(HoDILuminance(d),HoDILuminance(p))));
            }
        }
        float2 delta=abs(previous-traced),magnitude=max(previous,traced);
        float2 relative=delta/(magnitude+exp2(-12.0));
        // Inspect the whole stratum: zero old radiance may become visible.
        // Picking only its brightest old sample would miss that transition.
        if(relative.x>largest.x){largest.x=relative.x;gradient.x=delta.x;gradient.z=magnitude.x;}
        if(relative.y>largest.y){largest.y=relative.y;gradient.y=delta.y;gradient.w=magnitude.y;}
    }
    _HoRTDIGradientA[cell]=min(gradient,65504);
}
